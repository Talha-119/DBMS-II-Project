# ==========================================================================
# Copy this file to .env (in the project root) and fill in real values.
# The migration runner (database/migrate.js) and the server both read it.
# ==========================================================================

# --- PostgreSQL connection (superuser, used ONLY by migrate.js to create the
#     database, the app role, and all objects). On a default Windows install
#     the superuser is "postgres" and the password is what you set during setup.
PGHOST=localhost
PGPORT=5432
PGSUPERUSER=postgres
PGSUPERPASSWORD=postgres

# --- The application database + least-privilege role that the API connects as.
#     migrate.js creates these for you.
APP_DB=admission
APP_DB_USER=admission_app
APP_DB_PASSWORD=admission_app_pw

# --- Server runtime ---
PORT=4000
NODE_ENV=development

# JWT secret for school-authority / master-admin sessions (change in production)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=2h

# CORS allowlist (frontend origin)
CLIENT_ORIGIN=http://localhost:5173

# OTP behaviour. In dev we don't send real SMS; the code is returned in the API
# response and logged so you can test. Set OTP_DEV_RETURN=false to hide it.
OTP_DEV_RETURN=true
OTP_TTL_SECONDS=300
